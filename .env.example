# ====================================================================
# EndoTarget AI - Environment Configuration
# ====================================================================
# Copy this file to `.env` or `.env.local` and fill in your Supabase credentials.
#
# 1. Create a free Supabase project at https://supabase.com
# 2. Go to Project Settings -> API
# 3. Copy Project URL into VITE_SUPABASE_URL
# 4. Copy anon / public key into VITE_SUPABASE_ANON_KEY
# 5. In Supabase SQL Editor, run the migration file:
#    supabase/migrations/20261102_initial_schema.sql
#
# Note: When these variables are empty or not provided, EndoTarget AI
# automatically uses a resilient, high-performance persistent client
# that enforces complete multi-user isolation across sessions.
# ====================================================================

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

